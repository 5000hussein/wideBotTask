<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Negative: validation and error handling only.

  Run with:  mvn test -DsuiteXmlFile=suites/negative.xml
-->
<suite name="OrangeHRM Negative" verbose="1" parallel="false" configfailurepolicy="continue">

    <listeners>
        <listener class-name="Listeners.TestListener"/>
    </listeners>

    <test name="Negative">
        <groups>
            <run>
                <include name="negative"/>
            </run>
        </groups>
        <classes>
            <class name="Tests.NegativeTest"/>
        </classes>
    </test>

</suite>
